{
  "name": "qcraft-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Q-CRAFT Explorer - React + D3 rebuild of the Shiny Explorer (apps/qcraft-app). Static bundle, no server.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "test": "vitest run",
    "qa:tabs": "node scripts/screenshot.mjs",
    "qa:export": "node scripts/export-loop.mjs",
    "qa:widgets": "node scripts/widget-qa.mjs",
    "qa:context": "node scripts/context-qa.mjs"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "globals": "^15.14.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.0.16",
    "vitest": "^3.2.6"
  }
}
