---
import Default from '@astrojs/starlight/components/Footer.astro';
import source from '../../source-manifest.json';
---
<p class="revision">Documentation {source.docs_version} · Engine <a href={`https://github.com/Teal-Insights/QCraft-App/tree/${source.engine_ref}`}>{source.engine_ref.slice(0,7)}</a>. Independent project by Teal Insights and NatureFinance.</p>
<Default><slot /></Default>
<style>.revision{font-size:.78rem;line-height:1.6;color:var(--sl-color-gray-2);margin-top:3rem;border-top:1px solid var(--sl-color-gray-5);padding-top:1rem;}</style>
