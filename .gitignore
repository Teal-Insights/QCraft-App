# Which vintage `qcraft-pipeline select` last copied into data/processed. Local
# machine state, like the Parquet it sits beside.
data/processed/ACTIVE_VINTAGE

# Generated per-country vintage payloads (rebuild: uv run qcraft-pipeline run).
# The manifest and the country index stay in git so a vintage is reviewable.
data/vintages/*/json/*.json
!data/vintages/*/json/index.json

# Country payloads staged for the Explorer to fetch. Hard links to the above,
# rebuilt by `npm run stage:data` before every dev run and build.
apps/qcraft-web/public/data/

# Pipeline raw download cache
pipeline/.cache/

# Environment
.env
.env.*

# OS
.DS_Store

# This script (don't commit the scaffold itself)
setup-scaffold.sh

# Specstory
.specstory/

# Deployment bundle (build artifact)
deploy-bundle/

# Node / web app
node_modules/
.vite/
*.tsbuildinfo

# Session scaffolding: the orchestrator's per-run prompts and the live agent
# logs. They land in the clone root while a run is in flight, so a `git add -A`
# sweeps them in; agent-run*.log is being written as it is staged, and
# PROMPT-RUN<n>.md describes work that has not happened yet.
PROMPT.md
PROMPT-RUN*.md
agent-run*.log

# Cross-engine sweep dumps: one JSON per country per engine per vintage,
# regenerated by scripts/sweep/sweep_all.sh. The comparison reports beside them
# are the reviewable artifact; the dumps are not.
verification-logs/sweep/py-*/
verification-logs/sweep/ts-*/
verification-logs/sweep-prefix/

# Local copy of the processed inputs, used by the figure scripts. Parquet is
# already ignored above; this records where the directory comes from.
data/
